    "scale": {
      "clockRinging": { "size": 104, "weight": 200, "tracking": "-0.05em", "lineHeight": 0.95 },
      "clockHero":    { "size": 96,  "weight": 200, "tracking": "-0.05em", "lineHeight": 0.95 },
      "counter":      { "size": 96,  "weight": 200, "tracking": "-0.05em" },
