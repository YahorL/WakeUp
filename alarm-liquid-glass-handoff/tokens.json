    "ember":  { "orb1": "#FF6A2B", "orb2": "#FFB020", "orb3": "#8A4DFF", "fill": { "angle": 135, "from": "#C2410C", "to": "#B45309" } },
    "lagoon": { "orb1": "#2EE6C5", "orb2": "#3D7BFF", "orb3": "#9B5CFF", "fill": { "angle": 135, "from": "#0F766E", "to": "#1D4ED8" } }
  },
  "background": {
    "orbs": { "gradientStop": 0.66, "extraBlur": 10, "opacityMain": 0.85, "opacityLow": 0.6 },
    "grain": { "type": "fractalNoise", "baseFrequency": 0.85, "octaves": 3, "opacity": 0.22, "blend": "overlay" }
  },
  "glass": {
    "hero":    { "fill": { "angle": 160, "stops": [["rgba(255,255,255,0.13)", 0], ["rgba(255,255,255,0.035)", 0.6], ["rgba(255,255,255,0.06)", 1]] }, "border": "rgba(255,255,255,0.14)", "blur": 28, "saturate": 1.6, "highlight": "rgba(255,255,255,0.20)", "shadow": "0 30 60 -30 rgba(0,0,0,0.7)", "radius": 30 },
    "card":    { "fill": { "angle": 160, "stops": [["rgba(255,255,255,0.11)", 0], ["rgba(255,255,255,0.03)", 1]] }, "border": "rgba(255,255,255,0.13)", "blur": 24, "saturate": 1.5, "highlight": "rgba(255,255,255,0.16)", "radius": 28 },
    "control": { "fill": { "angle": 160, "stops": [["rgba(255,255,255,0.14)", 0], ["rgba(255,255,255,0.04)", 1]] }, "border": "rgba(255,255,255,0.14)", "blur": 20, "saturate": 1.5, "highlight": "rgba(255,255,255,0.18)", "radius": 999 },
    "tile":    { "fill": "rgba(255,255,255,0.06)", "border": "rgba(255,255,255,0.10)", "radius": 18 },
    "chip":    { "fill": "rgba(255,255,255,0.08)", "border": "rgba(255,255,255,0.13)", "radius": 999 }
  },
  "font": {
    "display": "Outfit",
