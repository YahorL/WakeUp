      "wheelNeighbor":{ "size": 40,  "weight": 200, "opacity": 0.32 },
      "answer":       { "size": 60,  "weight": 200 },
      "expression":   { "size": 46,  "weight": 300, "tracking": "-0.03em" },
      "rowTime":      { "size": 38,  "weight": 200, "tracking": "-0.04em" },
      "title":        { "size": 36,  "weight": 400, "tracking": "-0.03em" },
      "stepper":      { "size": 30,  "weight": 300 },
      "key":          { "size": 30,  "weight": 300 },
      "cardTitle":    { "size": 18,  "weight": 500 },
